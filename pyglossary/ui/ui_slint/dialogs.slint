// Secondary (non-modal) windows of the Slint UI, loaded via utils.load_slint.
// Opened from Python with `.show()`; results come back through callbacks or
// are read from in-out properties on OK.

import {
    Button,
    LineEdit,
    ScrollView,
    Switch,
    SpinBox,
    ComboBox,
    Palette,
    RadioGroup,
    StandardButton,
} from "std-widgets.slint";

// Keyboard shell for the dialogs: Return -> submit, Escape -> dismiss, other
// keys are offered to `other-key` (e.g. Up/Down list navigation). Takes focus
// on init and forwards it via `forward-focus`.
component DialogKeys inherits FocusScope {
    callback submit();
    callback dismiss();
    callback other-key(event: KeyEvent) -> EventResult;
    other-key(event) => { return EventResult.reject; }

    key-pressed(event) => {
        if (event.text == Key.Return) {
            root.submit();
            return EventResult.accept;
        }
        if (event.text == Key.Escape) {
            root.dismiss();
            return EventResult.accept;
        }
        return root.other-key(event);
    }

    init => { self.focus(); }

    @children
}

component OkCancelRow {
    callback ok();
    callback cancel();
    forward-focus: ok-btn;

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button {
            text: "Cancel";
            clicked => { root.cancel(); }
        }

        ok-btn := Button {
            text: "  OK  ";
            primary: true;
            clicked => { root.ok(); }
        }
    }
}

// ============================================================
// FormatPickerDialog: type to filter, Up/Down to move, Return to accept
// ============================================================
export component FormatPickerDialog inherits Window {
    title: "Select Format";
    preferred-width: 460px;
    preferred-height: 480px;
    min-width: 360px;
    min-height: 320px;

    in-out property <[string]> shown-formats: [];
    in-out property <int> current-index: -1;

    callback search-edited(string);
    callback ok();
    callback cancel();

    // No scroll-into-view API in slint: nudge `content-y` so row `i` is
    // visible. Rows are 24px with 1px spacing and 4px list padding. Call only
    // from callback context (key handler, timer), never from a `changed`
    // handler during layout (re-enters layout; panicked with 1.17.0b2).
    function reveal-index(i: int) {
        if (i < 0) {
            return;
        }
        let top = 4px + i * 25px;
        if (top < -format-scroll.content-y) {
            format-scroll.content-y = -top;
        } else if (top + 24px > -format-scroll.content-y + format-scroll.visible-height) {
            format-scroll.content-y = format-scroll.visible-height - (top + 24px);
        }
    }

    function step(delta: int) {
        if (root.shown-formats.length > 0) {
            root.current-index = clamp(root.current-index + delta, 0, root.shown-formats.length - 1);
            root.reveal-index(root.current-index);
        }
    }

    // post-layout: bring the active format into view (geometry is 0 at init)
    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            self.running = false;
            root.reveal-index(root.current-index);
        }
    }

    DialogKeys {
        forward-focus: search-input;
        submit => { root.ok(); }
        dismiss => { root.cancel(); }
        other-key(event) => {
            if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.step(event.text == Key.DownArrow ? 1 : -1);
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 8px;
            padding: 8px;

            search-input := LineEdit {
                placeholder-text: "Search formats…";
                edited(v) => { root.search-edited(v); }
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;

                format-scroll := ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 1px;
                        alignment: start;

                        for f[i] in root.shown-formats: Rectangle {
                            height: 24px;
                            border-radius: 3px;
                            background: i == root.current-index
                                ? Palette.accent-background
                                : (item-touch.has-hover ? Palette.alternate-background : transparent);
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    text: f;
                                    vertical-alignment: center;
                                    color: i == root.current-index
                                        ? Palette.accent-foreground
                                        : Palette.foreground;
                                }
                            }

                            item-touch := TouchArea {
                                clicked => { root.current-index = i; }
                                double-clicked => {
                                    root.current-index = i;
                                    root.ok();
                                }
                            }
                        }
                    }
                }
            }

            OkCancelRow {
                ok => { root.ok(); }
                cancel => { root.cancel(); }
            }
        }
    }
}

// ============================================================
// ThemeDialog: built-in widget style, applied on next launch
// ============================================================
export component ThemeDialog inherits Window {
    title: "Theme";
    preferred-width: 320px;
    preferred-height: 260px;

    in-out property <[string]> theme-names: [];  // labels of utils.SLINT_STYLES
    in-out property <int> current-index: -1;

    callback ok();
    callback cancel();

    // Same as FormatPickerDialog.reveal-index; rows are uniform GridLayout
    // rows with 8px spacing and 8px list padding.
    function reveal-index(i: int) {
        if (i < 0) {
            return;
        }
        let n = root.theme-names.length;
        let h = (theme-group.height - (n - 1) * 8px) / n;
        let top = 8px + i * (h + 8px);
        if (top - 4px < -theme-scroll.content-y) {
            theme-scroll.content-y = -(top - 4px);
        } else if (top + h + 4px > -theme-scroll.content-y + theme-scroll.visible-height) {
            theme-scroll.content-y = theme-scroll.visible-height - (top + h + 4px);
        }
    }

    function step(delta: int) {
        if (root.theme-names.length > 0) {
            root.current-index = clamp(root.current-index + delta, 0, root.theme-names.length - 1);
            root.reveal-index(root.current-index);
        }
    }

    Timer {
        interval: 50ms;
        running: true;
        triggered => {
            self.running = false;
            root.reveal-index(root.current-index);
        }
    }

    DialogKeys {
        forward-focus: buttons;
        submit => { root.ok(); }
        dismiss => { root.cancel(); }
        // radio-group convention: Up/Down move the selection from anywhere
        other-key(event) => {
            if (event.text == Key.DownArrow || event.text == Key.UpArrow) {
                root.step(event.text == Key.DownArrow ? 1 : -1);
                return EventResult.accept;
            }
            return EventResult.reject;
        }

        VerticalLayout {
            spacing: 12px;
            padding: 12px;

            Text {
                text: "Widget style. Takes effect after restarting the app.";
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.border;
                background: Palette.background;

                theme-scroll := ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        alignment: start;

                        // The public RadioGroup (up to slint 1.18.1b1) has no
                        // `current-index`/`select()`, so `root.current-index`
                        // is the master and is pushed per button. Never bind
                        // `checked:` -- the group writes `checked`, which would
                        // detach the binding. `want` (never written by the
                        // group) is pushed via `checked = true`: in `init` for
                        // the initial value (no `changed` fires for it), in
                        // `changed want` later; `toggled` mirrors clicks back.
                        theme-group := RadioGroup {
                            for theme[i] in root.theme-names: RadioButton {
                                text: theme;
                                property <bool> want: i == root.current-index;
                                init => {
                                    if (self.want) {
                                        self.checked = true;
                                    }
                                }
                                changed want => {
                                    if (self.want && !self.checked) {
                                        self.checked = true;
                                    }
                                }
                                toggled => {
                                    if (self.checked && root.current-index != i) {
                                        root.current-index = i;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            buttons := OkCancelRow {
                ok => { root.ok(); }
                cancel => { root.cancel(); }
            }
        }
    }
}

// ============================================================
// AlertDialog: built-in `Dialog` + `StandardButton` (platform button order)
// ============================================================
export component AlertDialog inherits Dialog {
    title: "Notice";
    preferred-width: 360px;
    preferred-height: 150px;

    in property <string> message: "";

    // declared explicitly (same name Dialog generates for the ok button) so
    // Return/Escape can invoke it too
    callback ok-clicked();

    DialogKeys {
        submit => { root.ok-clicked(); }
        dismiss => { root.ok-clicked(); }

        VerticalLayout {
            padding: 16px;
            Text {
                text: root.message;
                wrap: word-wrap;
            }
        }
    }

    StandardButton {
        kind: ok;
        clicked => { root.ok-clicked(); }
    }
}

// ============================================================
// OptionsDialog: Read/Write format options; `kind` picks the widget
// ("bool" Switch, "int" SpinBox, "choice" ComboBox, "str" LineEdit)
// ============================================================
export struct OptionItem {
    name: string,
    comment: string,
    kind: string,
    bool-value: bool,
    str-value: string,  // also the current value of "choice"
    int-value: int,
    choices: [string],
}

export component OptionsDialog inherits Window {
    title: "Format Options";
    preferred-width: 640px;
    preferred-height: 520px;
    min-width: 420px;
    min-height: 320px;

    in-out property <string> title-text: "Format Options";
    in-out property <[OptionItem]> options: [];

    callback set-bool(int, bool);
    callback set-str(int, string);
    callback set-int(int, int);
    callback ok();
    callback cancel();

    DialogKeys {
        forward-focus: buttons;
        submit => { root.ok(); }
        dismiss => { root.cancel(); }

        VerticalLayout {
            spacing: 8px;
            padding: 12px;

            Text {
                text: root.title-text;
                font-size: 14px;
                font-weight: 700;
            }

            ScrollView {
                VerticalLayout {
                    spacing: 10px;
                    padding: 4px;
                    alignment: start;

                    for opt[i] in root.options: VerticalLayout {
                        spacing: 4px;

                        Text {
                            text: opt.comment;
                            font-size: 12px;
                            color: Palette.foreground.transparentize(0.25);
                        }

                        if opt.kind == "bool": Switch {
                            text: opt.name;
                            checked: opt.bool-value;
                            toggled => { root.set-bool(i, self.checked); }
                        }

                        // fixed height: ComboBox would otherwise stretch vertically
                        if opt.kind != "bool": HorizontalLayout {
                            spacing: 8px;
                            height: 32px;
                            Text {
                                text: opt.name;
                                vertical-alignment: center;
                                width: 180px;
                            }

                            if opt.kind == "int": SpinBox {
                                value: opt.int-value;
                                minimum: 0;
                                maximum: 1000000000;
                                edited(v) => { root.set-int(i, v); }
                                horizontal-stretch: 1;
                            }
                            if opt.kind == "choice": ComboBox {
                                model: opt.choices;
                                current-value: opt.str-value;
                                selected(v) => { root.set-str(i, v); }
                            }
                            if opt.kind == "str": LineEdit {
                                text: opt.str-value;
                                edited(v) => { root.set-str(i, v); }
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            buttons := OkCancelRow {
                ok => { root.ok(); }
                cancel => { root.cancel(); }
            }
        }
    }
}

// ============================================================
// GeneralOptionsDialog: scalar fields are two-way; Python reads them on OK
// ============================================================
export struct ConfigCheck {
    comment: string,
    value: bool,
}

export component GeneralOptionsDialog inherits Window {
    title: "General Options";
    preferred-width: 560px;
    preferred-height: 560px;
    min-width: 420px;
    min-height: 360px;

    in-out property <bool> sort-enabled: false;
    in-out property <[string]> sort-key-descs: [];
    in-out property <string> current-sort-key: "";
    in-out property <bool> sort-encoding-enabled: false;
    in-out property <string> sort-encoding: "utf-8";
    in-out property <string> sort-locale: "";
    in-out property <bool> sqlite-enabled: false;
    in-out property <[ConfigCheck]> config-checks: [];

    callback set-config(int, bool);
    callback ok();
    callback cancel();

    DialogKeys {
        forward-focus: buttons;
        submit => { root.ok(); }
        dismiss => { root.cancel(); }

        VerticalLayout {
            spacing: 10px;
            padding: 12px;

            HorizontalLayout {
                spacing: 8px;
                Switch {
                    text: "Sort entries by";
                    checked <=> root.sort-enabled;
                }

                ComboBox {
                    model: root.sort-key-descs;
                    current-value <=> root.current-sort-key;
                    horizontal-stretch: 1;
                    enabled: root.sort-enabled;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Switch {
                    text: "Sort Encoding";
                    checked <=> root.sort-encoding-enabled;
                    enabled: root.sort-enabled;
                }

                LineEdit {
                    text <=> root.sort-encoding;
                    enabled: root.sort-enabled && root.sort-encoding-enabled;
                    width: 160px;
                }

                Text {
                    text: "Locale";
                    vertical-alignment: center;
                }

                LineEdit {
                    text <=> root.sort-locale;
                    enabled: root.sort-enabled;
                    horizontal-stretch: 1;
                }
            }

            Switch {
                text: "SQLite mode";
                checked <=> root.sqlite-enabled;
            }

            Rectangle {
                vertical-stretch: 1;
                border-width: 1px;
                border-color: Palette.border;
                ScrollView {
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        for c[i] in root.config-checks: Switch {
                            text: c.comment;
                            checked: c.value;
                            toggled => { root.set-config(i, self.checked); }
                        }
                    }
                }
            }

            buttons := OkCancelRow {
                ok => { root.ok(); }
                cancel => { root.cancel(); }
            }
        }
    }
}

// ============================================================
// InfoDialog: name / sourceLang / targetLang
// ============================================================
export component InfoDialog inherits Window {
    title: "Set Info / Metadata";
    preferred-width: 520px;
    preferred-height: 220px;
    min-width: 360px;

    in-out property <string> name-value: "";
    in-out property <string> source-lang: "";
    in-out property <string> target-lang: "";

    callback ok();
    callback cancel();

    DialogKeys {
        forward-focus: name-input;
        submit => { root.ok(); }
        dismiss => { root.cancel(); }

        VerticalLayout {
            spacing: 10px;
            padding: 12px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Glossary Name";
                    vertical-alignment: center;
                    width: 140px;
                }

                name-input := LineEdit {
                    text <=> root.name-value;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Source Language";
                    vertical-alignment: center;
                    width: 140px;
                }

                LineEdit {
                    text <=> root.source-lang;
                    horizontal-stretch: 1;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Target Language";
                    vertical-alignment: center;
                    width: 140px;
                }

                LineEdit {
                    text <=> root.target-lang;
                    horizontal-stretch: 1;
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }

            OkCancelRow {
                ok => { root.ok(); }
                cancel => { root.cancel(); }
            }
        }
    }
}
