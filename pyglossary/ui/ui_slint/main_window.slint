// Main window of the Slint UI (mirrors ui_tk): Convert tab with file/format
// pickers, console and status bar; About tab. Loaded via utils.load_slint;
// kebab-case names are snake_case on the Python side.

import {
    Button,
    LineEdit,
    TabWidget,
    ScrollView,
    ProgressIndicator,
    Palette,
} from "std-widgets.slint";

export struct ConsoleLine {
    text: string,
    text-color: color,
}

// A ComboBox whose popup opens upward, for selectors at the window's bottom
// edge (a stock ComboBox popup is clipped to the window and opens downward).
// TODO: replace with stock ComboBox once slint #4870 (popup anchoring) is fixed.
component UpComboBox inherits Rectangle {
    in-out property <[string]> model;
    in-out property <string> current-value;
    callback selected(string);

    // keyboard cursor inside the open popup; rows sync it on open (their
    // `init` runs when the popup is shown)
    property <int> highlight: 0;

    forward-focus: fs;

    height: 28px;
    border-width: 1px;
    border-radius: 4px;
    border-color: fs.has-focus ? Palette.accent-background : Palette.border;
    // Palette.control-background is translucent by design (Fluent layering),
    // so it must sit on an opaque surface; use the opaque window background.
    background: Palette.background;

    function open-popup() {
        popup.show();
        // showing the popup moves keyboard focus into it; take it back so
        // the arrow/Return/Escape handling below keeps working while open
        fs.focus();
    }

    function commit(index: int) {
        if (index >= 0 && index < root.model.length) {
            root.highlight = index;
            root.current-value = root.model[index];
            root.selected(root.model[index]);
        }
        popup.close();
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;
        Text {
            text: root.current-value;
            color: Palette.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        Text {
            text: "▲";
            font-size: 10px;
            color: Palette.foreground;
            vertical-alignment: center;
        }
    }

    fs := FocusScope {
        key-pressed(event) => {
            if (!popup.is-open) {
                if (event.text == Key.Return || event.text == " "
                        || event.text == Key.DownArrow || event.text == Key.UpArrow) {
                    root.open-popup();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }
            if (event.text == Key.DownArrow) {
                root.highlight = Math.min(root.highlight + 1, root.model.length - 1);
                return EventResult.accept;
            }
            if (event.text == Key.UpArrow) {
                root.highlight = Math.max(root.highlight - 1, 0);
                return EventResult.accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                root.commit(root.highlight);
                return EventResult.accept;
            }
            if (event.text == Key.Escape) {
                popup.close();
                return EventResult.accept;
            }
            return EventResult.reject;
        }
    }

    // a press outside the open popup closes it and is consumed, so this only
    // ever fires while the popup is closed
    TouchArea {
        clicked => { root.open-popup(); }
    }

    popup := PopupWindow {
        x: 0;
        // place the popup's bottom edge at the trigger's top edge, so the list
        // grows up into the visible window area rather than off the bottom
        y: -self.height;
        width: root.width;
        close-policy: close-on-click-outside;

        Rectangle {
            // opaque fill so the list does not show the console behind it
            background: Palette.background;
            border-width: 1px;
            border-radius: 4px;
            border-color: Palette.border;

            VerticalLayout {
                padding: 2px;
                spacing: 0px;

                for item[i] in root.model: Rectangle {
                    height: 26px;
                    border-radius: 3px;
                    background: (item-touch.has-hover || i == root.highlight)
                        ? Palette.accent-background
                        : (item == root.current-value
                        ? Palette.alternate-background
                        : transparent);

                    // rows are created when the popup opens: start the
                    // keyboard cursor on the currently selected item
                    init => {
                        if (item == root.current-value) {
                            root.highlight = i;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        Text {
                            text: item;
                            vertical-alignment: center;
                            color: (item-touch.has-hover || i == root.highlight)
                                ? Palette.accent-foreground
                                : Palette.foreground;
                        }
                    }

                    item-touch := TouchArea {
                        clicked => { root.commit(i); }
                    }
                }
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "PyGlossary (Slint)";
    preferred-width: 960px;
    preferred-height: 520px;
    min-width: 760px;
    min-height: 440px;
    // state, read/written from Python (ui.py)
    in-out property <string> input-file-path: "";
    in-out property <string> output-file-path: "";
    in-out property <string> input-format: "(choose input format)";
    in-out property <string> output-format: "(choose output format)";
    in-out property <[string]> verbosity-levels;  // from log.levelNamesCap
    in-out property <string> verbosity;
    in-out property <[ConsoleLine]> console-lines: [];
    in-out property <float> progress: 0.0;
    in-out property <string> status-text: "";
    in-out property <bool> converting: false;
    in-out property <string> about-text;

    callback browse-input-file();
    callback browse-output-file();
    callback choose-input-format();
    callback choose-output-format();
    callback options-selected(string);
    callback start-convert();
    callback clear-console();
    callback verbosity-changed(string);
    // typing in a path field triggers auto format detection
    callback input-file-edited(string);
    callback output-file-edited(string);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        TabWidget {
            Tab {
                title: "Convert";

                VerticalLayout {
                    spacing: 10px;
                    padding: 6px;

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Input File:";
                            vertical-alignment: center;
                            width: 96px;
                        }

                        LineEdit {
                            // two-way: a one-way binding is detached once the
                            // widget writes `text` (typing), after which
                            // Python-side updates would no longer show
                            text <=> root.input-file-path;
                            placeholder-text: "Path to input glossary file";
                            edited(value) => {
                                root.input-file-edited(value);
                            }
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Browse";
                            clicked => { root.browse-input-file(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Input Format:";
                            vertical-alignment: center;
                            width: 96px;
                        }

                        Button {
                            text: root.input-format;
                            horizontal-stretch: 1;
                            clicked => { root.choose-input-format(); }
                        }
                    }

                    Rectangle {
                        height: 6px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Output File:";
                            vertical-alignment: center;
                            width: 96px;
                        }

                        LineEdit {
                            text <=> root.output-file-path;
                            placeholder-text: "Path to output glossary file";
                            edited(value) => {
                                root.output-file-edited(value);
                            }
                            horizontal-stretch: 1;
                        }

                        Button {
                            text: "Browse";
                            clicked => { root.browse-output-file(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: "Output Format:";
                            vertical-alignment: center;
                            width: 96px;
                        }

                        Button {
                            text: root.output-format;
                            horizontal-stretch: 1;
                            clicked => { root.choose-output-format(); }
                        }
                    }

                    Rectangle {
                        height: 4px;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        UpComboBox {
                            // "Options" is only the closed-state caption, not
                            // a model entry, so the popup lists actions only
                            model: ["Read Options", "Write Options", "General Options", "Info / Metadata", "Theme"];
                            current-value: "Options";
                            selected(value) => {
                                root.options-selected(value);
                                // restore the static caption instead of
                                // showing the last-picked action as selection
                                self.current-value = "Options";
                            }
                            width: 140px;
                        }

                        Button {
                            text: root.converting ? "Converting…" : "Convert";
                            enabled: !root.converting;
                            primary: true;
                            horizontal-stretch: 1;
                            clicked => { root.start-convert(); }
                        }
                    }

                    Rectangle {
                        background: #000000;
                        border-width: 1px;
                        border-color: #444444;
                        vertical-stretch: 1;

                        ScrollView {
                            VerticalLayout {
                                padding: 6px;
                                spacing: 2px;
                                alignment: start;

                                for line in root.console-lines: Text {
                                    text: line.text;
                                    color: line.text-color;
                                    font-family: "Courier New";
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }

            Tab {
                title: "About";

                ScrollView {
                    VerticalLayout {
                        padding: 16px;
                        spacing: 8px;
                        alignment: start;

                        Text {
                            text: "PyGlossary — Slint UI";
                            font-size: 18px;
                            font-weight: 700;
                        }

                        StyledText {
                            text: @markdown("[https://github.com/ilius/pyglossary](https://github.com/ilius/pyglossary)");
                            link-color: Palette.color-scheme == ColorScheme.dark ? #6cb6ff : #0a58ca;
                            default-font-size: 10pt;
                        }

                        Text {
                            text: root.about-text;
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            height: 28px;

            Button {
                text: "Clear";
                clicked => { root.clear-console(); }
            }

            Text {
                text: "Verbosity";
                vertical-alignment: center;
            }

            UpComboBox {
                model: root.verbosity-levels;
                current-value <=> root.verbosity;
                selected(value) => {
                    root.verbosity-changed(value);
                }
                width: 140px;
            }

            ProgressIndicator {
                progress: root.progress;
                horizontal-stretch: 1;
            }

            Text {
                text: root.status-text;
                color: #c9b400;
                vertical-alignment: center;
            }
        }
    }
}
